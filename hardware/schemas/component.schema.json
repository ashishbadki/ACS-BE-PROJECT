{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acs-project-be.local/schemas/component.schema.json",
  "title": "ACS Hardware Component",
  "description": "Machine-readable schema for hardware components used by the ACS hardware-aware robotics framework.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "identity",
    "classification",
    "capabilities",
    "interfaces"
  ],

  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string"
        },
        "part_number": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },

    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "controller",
            "sensor",
            "display",
            "actuator",
            "driver",
            "input",
            "output",
            "power",
            "communication",
            "mechanical"
          ]
        },
        "subcategory": {
          "type": "string"
        }
      }
    },

    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },

    "interfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gpio",
          "adc",
          "pwm",
          "i2c",
          "spi",
          "uart",
          "can",
          "usb",
          "wifi",
          "bluetooth",
          "analog",
          "digital"
        ]
      },
      "uniqueItems": true
    },

    "pins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      }
    },

    "electrical": {
      "$ref": "#/$defs/electrical"
    },

    "physical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        },
        "weight_g": {
          "type": "number",
          "minimum": 0
        },
        "mounting": {
          "type": "string"
        },
        "connector": {
          "type": "string"
        }
      }
    },

    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },

    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controllers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },

    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "libraries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },

    "hal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/halOperation"
          },
          "uniqueItems": true
        }
      }
    },

    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "safety": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },

  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "power",
            "ground",
            "gpio",
            "analog",
            "pwm",
            "i2c_data",
            "i2c_clock",
            "spi",
            "uart",
            "interrupt",
            "control",
            "motor"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional",
            "power"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },

    "electrical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voltage": {
          "$ref": "#/$defs/voltage"
        },
        "current": {
          "$ref": "#/$defs/current"
        },
        "power_w": {
          "type": "number",
          "minimum": 0
        },
        "logic_level": {
          "type": "string"
        }
      }
    },

    "voltage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "typical": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "const": "V"
        }
      }
    },

    "current": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typical": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "const": "mA"
        }
      }
    },

    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length_mm": {
          "type": "number",
          "minimum": 0
        },
        "width_mm": {
          "type": "number",
          "minimum": 0
        },
        "height_mm": {
          "type": "number",
          "minimum": 0
        }
      }
    },

    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "component",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "alternative"
          ]
        },
        "component": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },

    "halOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}